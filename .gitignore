# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dashboard secret tmp
.dashboard-password.tmp
.env.bot

.vercel

# old local dev screenshots (may contain real data)
/sl-*.png
/v-*.png
/t-bottom.png

# third-party agent tool cache
.impeccable/

# security audit report — NEVER publish (it maps live vulnerabilities)
SECURITY-AUDIT.md
.gstack/
